{
  "name": "nexai-warehouse-digital-twin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:python": "python3 -m unittest discover -s tests",
    "audit": "npm audit --audit-level=low",
    "check": "tsc -b",
    "verify": "npm run check && npm run test && npm run test:python && npm run audit && npm run build"
  },
  "dependencies": {
    "@react-three/drei": "9.122.0",
    "@react-three/fiber": "8.18.0",
    "lucide-react": "1.61.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "3.10.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.1.4",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  }
}
